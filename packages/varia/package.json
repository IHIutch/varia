{
  "name": "varia",
  "type": "module",
  "version": "0.0.0",
  "description": "Build-time component variants",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown && cp -f stub/types.d.mts dist/types.d.mts",
    "test": "pnpm run build && vitest run",
    "test:watch": "pnpm run build && vitest",
    "typecheck": "tsc --noEmit",
    "test:visual": "pnpm run build && vitest run --config vitest.browser.config.ts"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "4.1.5",
    "playwright": "1.61.1",
    "postcss": "^8.5.14",
    "tsdown": "^0.22.0",
    "vitest": "^4.1.5"
  }
}
