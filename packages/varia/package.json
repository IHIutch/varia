{
  "name": "varia",
  "type": "module",
  "version": "1.0.0",
  "description": "Build-time component variants",
  "author": "Jonathan Hutchison",
  "license": "MIT",
  "homepage": "https://github.com/IHIutch/varia#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IHIutch/varia.git",
    "directory": "packages/varia"
  },
  "bugs": {
    "url": "https://github.com/IHIutch/varia/issues"
  },
  "keywords": [
    "tailwindcss",
    "css",
    "variants",
    "components"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.mts",
      "import": "./dist/tailwind.mjs"
    },
    "./tailwind.css": "./dist/tailwind.css"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "API.md",
    "CHANGELOG.md",
    "dist"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "prepack": "pnpm run build && cp ../../README.md ../../API.md ../../LICENSE ../../CHANGELOG.md .",
    "build": "tsdown && cp -f stub/types.d.mts dist/types.d.mts",
    "test": "pnpm run build && vitest run",
    "test:watch": "pnpm run build && vitest",
    "typecheck": "tsc --noEmit",
    "test:visual": "pnpm run build && vitest run --config vitest.browser.config.ts",
    "test:reload": "pnpm run build && vitest run --config vitest.reload.config.ts"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.61.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.0",
    "vite": "8.0.16",
    "vitest": "^5.0.3"
  }
}
