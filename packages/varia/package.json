{
  "name": "varia",
  "type": "module",
  "version": "0.0.0",
  "description": "Build-time variants for UnoCSS",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "import": "./dist/preset.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown && cp -f stub/types.d.mts dist/types.d.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@unocss/core": "*",
    "unocss": "*"
  },
  "devDependencies": {
    "@unocss/core": "^66.6.8",
    "@unocss/preset-wind4": "^66.6.8",
    "tsdown": "^0.22.0",
    "unocss": "^66.6.8",
    "vitest": "^4.1.5"
  }
}
