{
  "name": "varia",
  "type": "module",
  "version": "0.0.0",
  "description": "Build-time component variants for Tailwind CSS",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.mts",
      "import": "./dist/tailwind.mjs"
    },
    "./tailwind.css": "./dist/tailwind.css"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown && cp -f stub/types.d.mts dist/types.d.mts",
    "test": "pnpm run build && vitest run",
    "test:watch": "pnpm run build && vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.0",
    "vitest": "^4.1.5"
  }
}
