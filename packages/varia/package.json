{
  "name": "varia",
  "type": "module",
  "version": "0.0.0",
  "description": "Build-time component variants",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.mts",
      "import": "./dist/tailwind.mjs"
    },
    "./tailwind.css": "./dist/tailwind.css"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsdown && cp -f stub/types.d.mts dist/types.d.mts",
    "test": "pnpm run build && vitest run",
    "test:watch": "pnpm run build && vitest",
    "typecheck": "tsc --noEmit",
    "test:visual": "pnpm run build && vitest run --config vitest.browser.config.ts",
    "test:reload": "pnpm run build && vitest run --config vitest.reload.config.ts"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.61.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.0",
    "vite": "^8.0.11",
    "vitest": "^5.0.3"
  }
}
