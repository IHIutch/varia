{
  "name": "varia-workspace",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "description": "Workspace root for varia (library, example)",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "pnpm --filter varia build",
    "test": "pnpm --filter varia test",
    "test:watch": "pnpm --filter varia test:watch",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "example:dev": "pnpm --filter @varia/example dev",
    "example:build": "pnpm --filter @varia/example build",
    "comparison:check": "node scripts/check-comparison.mjs",
    "comparison:reload": "pnpm build && node scripts/check-reload.mjs",
    "test:visual": "pnpm --filter varia test:visual",
    "test:reload": "pnpm --filter varia test:reload",
    "test:editor": "pnpm --filter varia test:editor",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
