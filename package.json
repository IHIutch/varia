{
  "name": "varia",
  "type": "module",
  "version": "0.0.0",
  "description": "Build-time variants for UnoCSS",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "import": "./dist/preset.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown && cp -f stub/types.d.mts dist/types.d.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "@unocss/core": "*",
    "unocss": "*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@types/node": "^25.6.2",
    "@unocss/core": "^66.6.8",
    "@unocss/preset-wind4": "^66.6.8",
    "@unocss/vite": "^66.6.8",
    "eslint": "^10.3.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "unocss": "^66.6.8",
    "vite": "^8.0.11",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.5"
  }
}
