{
  "name": "@varia/docs",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "VitePress site for varia",
  "scripts": {
    "dev": "vitepress dev .",
    "build": "vitepress build .",
    "preview": "vitepress preview .",
    "typecheck": "tsc --noEmit",
    "deploy-pages": "pnpm run build && pnpm dlx wrangler pages deploy .vitepress/dist --project-name=varia-docs"
  },
  "dependencies": {
    "varia": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vitepress": "^1.6.4"
  }
}
